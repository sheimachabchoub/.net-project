<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MediaLib.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenduInteractif" />
</head>

<body>
    <Routes @rendermode="RenduInteractif" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Sans pré-rendu : le jeton est lu dans le navigateur (ProtectedLocalStorage) dès le premier rendu.
    private static readonly IComponentRenderMode RenduInteractif = new InteractiveServerRenderMode(prerender: false);
}
