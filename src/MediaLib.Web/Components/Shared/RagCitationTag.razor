@inject ApiClient Api

@* Fiche de source : « Source : Titre — Version / Section », cliquable pour lire le passage cité. *@
<button type="button" class="citation" @onclick="Ouvrir" title="Lire le passage cité">
    <span class="etiquette">Source</span>
    <strong>@Source.Titre — Version @Source.Version</strong>
    <span>Section : @Source.Section</span>
</button>

@if (_ouvert)
{
    <div class="tiroir-fond" @onclick="() => _ouvert = false"></div>
    <aside class="tiroir" role="dialog" aria-label="Source citée">
        <div class="ligne" style="justify-content:space-between">
            <span class="surtitre" style="margin:0">Version @Source.Version</span>
            <button class="btn btn-contour btn-petit" @onclick="() => _ouvert = false">Fermer</button>
        </div>
        <h2 style="margin-top:.8rem">@Source.Titre</h2>
        <h3>@Source.Section</h3>
        <hr class="filet" />
        @if (_extrait is null)
        {
            <p class="discret">Chargement du passage…</p>
        }
        else
        {
            <p style="white-space:pre-line">@_extrait</p>
        }
    </aside>
}

@code {
    [Parameter, EditorRequired] public SourceDto Source { get; set; } = default!;

    private bool _ouvert;
    private string? _extrait;

    private async Task Ouvrir()
    {
        _ouvert = true;
        if (_extrait is not null) return;
        var r = await Api.GetAsync<List<ExtraitDto>>($"api/documents/recherche?limite=10&q={Uri.EscapeDataString(Source.Section + " " + Source.Titre)}");
        _extrait = r.Valeur?.FirstOrDefault(e => e.Titre == Source.Titre && e.Section == Source.Section)?.Contenu
                   ?? "Ce passage n'est plus publié (document archivé ou modifié).";
    }
}
