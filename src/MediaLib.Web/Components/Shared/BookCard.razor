@* Carte livre : couverture dessinée (reliure + filets dorés), titre, auteur, disponibilité, accès au détail. *@
<article class="carte-livre">
    <Couverture Livre="Livre" />
    <div class="corps">
        <h3 class="titre-livre">@Livre.Titre</h3>
        <span class="auteur">@Livre.AuteurNom</span>
        <div class="bas">
            <span class="badge @(Livre.NbDisponibles > 0 ? "badge-olive" : "badge-ardoise")">
                @(Livre.NbDisponibles > 0 ? "Disponible" : "Indisponible")
            </span>
            <a class="btn btn-contour btn-petit" href="livres/@Livre.Id" aria-label="Voir le détail de @Livre.Titre">Détail</a>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public LivreDto Livre { get; set; } = default!;
}
