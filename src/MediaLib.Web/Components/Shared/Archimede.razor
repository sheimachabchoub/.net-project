@* Archimède, le hibou bibliothécaire, avec sa lampe : repos / recherche (halo qui pulse) / réponse prête. *@
<div class="perchoir @ClasseEtat" aria-live="polite">
    <svg viewBox="0 0 200 175" role="img" aria-label="Archimède, le hibou bibliothécaire">
        @Dessins.DefinitionsHalo
        <g transform="translate(132 62)">@Dessins.Lampe()</g>
        <g transform="translate(6 6)">@Dessins.Hibou</g>
        <path d="M4 168h192" stroke="#4A3428" stroke-width="2.2" stroke-linecap="round" />
    </svg>
    <div>
        <div class="nom-mascotte">Archimède</div>
        <div class="etat">@TexteEtat</div>
    </div>
</div>

@code {
    public enum EtatArchimede { Repos, Recherche, Pret }

    [Parameter] public EtatArchimede Etat { get; set; }

    private string ClasseEtat => Etat switch { EtatArchimede.Recherche => "lampe-recherche", EtatArchimede.Pret => "lampe-prete", _ => "" };

    private string TexteEtat => Etat switch
    {
        EtatArchimede.Recherche => "consulte ses registres…",
        EtatArchimede.Pret => "a trouvé une réponse.",
        _ => "vous écoute.",
    };
}
