@page "/livres/{Id:int}"
@inject ApiClient Api

<PageTitle>@(_livre?.Titre ?? "Livre") — MediaLib</PageTitle>

<Message Erreur="@_erreur" Succes="@_succes" />
@if (_livre is not null)
{
    <a href="catalogue" class="discret">← Retour au catalogue</a>
    <div class="ligne" style="align-items:flex-start;gap:1.6rem;margin-top:.8rem">
        <div style="width:220px;flex:none"><BookCard Livre="_livre" /></div>
        <div style="flex:1;min-width:260px">
            <h1>@_livre.Titre</h1>
            <p><strong>@_livre.AuteurNom</strong> · @_livre.Annee · <span class="manuscrit">@_livre.CategorieNom</span></p>
            <p class="lettrine">@(_livre.Resume ?? "Pas encore de résumé pour cet ouvrage.")</p>
            <table class="registre" style="max-width:420px">
                <tr><th>ISBN</th><td>@_livre.Isbn</td></tr>
                <tr><th>Exemplaires</th><td>@_livre.NbExemplaires</td></tr>
                <tr><th>Disponibles</th><td>@_livre.NbDisponibles</td></tr>
            </table>
            <div class="ligne" style="margin-top:1rem">
                <AuthorizeView Roles="@Roles.Membre">
                    <Authorized>
                        @if (_livre.NbDisponibles > 0)
                        {
                            <button class="btn btn-principal" disabled="@_occupe" @onclick="Emprunter">Emprunter ce livre</button>
                        }
                        else
                        {
                            <button class="btn btn-secondaire" disabled="@_occupe" @onclick="Reserver">Réserver ce livre</button>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-principal" href="connexion?returnUrl=@Uri.EscapeDataString($"/livres/{Id}")">Se connecter pour emprunter</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
}
else if (_erreur is null)
{
    <p class="manuscrit">On cherche la fiche…</p>
}

@code {
    [Parameter] public int Id { get; set; }

    private LivreDto? _livre;
    private string? _erreur, _succes;
    private bool _occupe;

    protected override async Task OnParametersSetAsync() => await Charger();

    private async Task Charger()
    {
        var r = await Api.GetAsync<LivreDto>($"api/livres/{Id}");
        _livre = r.Valeur;
        if (!r.Ok) _erreur = r.Erreur;
    }

    private async Task Emprunter()
    {
        _occupe = true;
        _erreur = _succes = null;
        var r = await Api.PostAsync<EmpruntDto>("api/emprunts", new EmpruntRequete { LivreId = Id });
        if (r.Ok) _succes = $"C'est noté ! « {r.Valeur!.LivreTitre} » est à rendre le {r.Valeur.DateRetourPrevue:dd/MM/yyyy}.";
        else _erreur = r.Erreur;
        await Charger();
        _occupe = false;
    }

    private async Task Reserver()
    {
        _occupe = true;
        _erreur = _succes = null;
        var r = await Api.PostAsync<ReservationDto>("api/reservations", new ReservationRequete { LivreId = Id });
        if (r.Ok) _succes = $"Réservation enregistrée : vous êtes n°{r.Valeur!.Position} dans la file. Nous vous préviendrons au retour du livre.";
        else _erreur = r.Erreur;
        _occupe = false;
    }
}
