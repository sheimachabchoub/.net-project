@page "/livres/{Id:int}"
@inject ApiClient Api

<PageTitle>@(_livre?.Titre ?? "Livre") — MediaLib</PageTitle>

<p><a href="catalogue">← Retour au catalogue</a></p>
<Message Erreur="@_erreur" Succes="@_succes" />

@if (_livre is not null)
{
    <article class="livre-ouvert">
        <div class="page-g">
            <Couverture Livre="_livre" />
            <span class="badge @(_livre.NbDisponibles > 0 ? "badge-olive" : "badge-ardoise")" style="align-self:flex-start">
                @(_livre.NbDisponibles > 0 ? $"{_livre.NbDisponibles} exemplaire(s) disponible(s)" : "Aucun exemplaire disponible")
            </span>
        </div>
        <div class="page-d">
            <div class="surtitre">@_livre.CategorieNom</div>
            <h1>@_livre.Titre</h1>
            <p style="font-size:1.05rem">par <strong>@_livre.AuteurNom</strong></p>
            <hr class="filet" />
            <p>@(_livre.Resume ?? "Pas encore de résumé pour cet ouvrage.")</p>
            <dl class="fiche-technique">
                <dt>Auteur</dt><dd>@_livre.AuteurNom</dd>
                <dt>Catégorie</dt><dd>@_livre.CategorieNom</dd>
                <dt>Année</dt><dd>@_livre.Annee</dd>
                <dt>ISBN</dt><dd>@_livre.Isbn</dd>
                <dt>Exemplaires</dt><dd>@_livre.NbDisponibles disponible(s) sur @_livre.NbExemplaires</dd>
            </dl>
            <AuthorizeView Roles="@Roles.Membre">
                <Authorized>
                    <div class="ligne">
                        <button class="btn btn-principal" disabled="@(_occupe || _livre.NbDisponibles == 0)" @onclick="Emprunter">Emprunter</button>
                        <button class="btn btn-contour" disabled="@(_occupe || _livre.NbDisponibles > 0)" @onclick="Reserver">Réserver</button>
                    </div>
                    <p class="discret" style="margin-top:.6rem">
                        @(_livre.NbDisponibles > 0
                            ? "Le livre est disponible : vous pouvez l'emprunter directement."
                            : "Le livre est sorti : réservez-le, nous vous préviendrons à son retour.")
                    </p>
                </Authorized>
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <p class="discret">Les emprunts et réservations se font avec un compte Membre.</p>
                    }
                    else
                    {
                        <a class="btn btn-principal" href="connexion?returnUrl=@Uri.EscapeDataString($"/livres/{Id}")">Se connecter pour emprunter ou réserver</a>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </article>
}
else if (_erreur is null)
{
    <p class="discret">Chargement de la fiche…</p>
}

@code {
    [Parameter] public int Id { get; set; }

    private LivreDto? _livre;
    private string? _erreur, _succes;
    private bool _occupe;

    protected override async Task OnParametersSetAsync() => await Charger();

    private async Task Charger()
    {
        var r = await Api.GetAsync<LivreDto>($"api/livres/{Id}");
        _livre = r.Valeur;
        if (!r.Ok) _erreur = r.Erreur;
    }

    private async Task Emprunter()
    {
        _occupe = true;
        _erreur = _succes = null;
        var r = await Api.PostAsync<EmpruntDto>("api/emprunts", new EmpruntRequete { LivreId = Id });
        if (r.Ok) _succes = $"C'est noté : « {r.Valeur!.LivreTitre} » est à rendre le {r.Valeur.DateRetourPrevue:dd/MM/yyyy}.";
        else _erreur = r.Erreur;
        await Charger();
        _occupe = false;
    }

    private async Task Reserver()
    {
        _occupe = true;
        _erreur = _succes = null;
        var r = await Api.PostAsync<ReservationDto>("api/reservations", new ReservationRequete { LivreId = Id });
        if (r.Ok) _succes = $"Réservation enregistrée : vous êtes n°{r.Valeur!.Position} dans la file d'attente.";
        else _erreur = r.Erreur;
        _occupe = false;
    }
}
