@page "/catalogue"
@inject ApiClient Api

<PageTitle>Catalogue — MediaLib</PageTitle>
<div class="entete-page">
    <h1>Catalogue</h1>
    <p>Cherchez par titre, auteur ou ISBN, puis filtrez par catégorie ou disponibilité.</p>
</div>

<form class="recherche" @onsubmit="Rechercher" @onsubmit:preventDefault role="search">
    <div class="champs-recherche">
        <div>
            <label for="q">Recherche</label>
            <input id="q" type="search" @bind="_q" placeholder="Titre, auteur ou ISBN…" />
        </div>
        <div>
            <label for="tri">Trier par</label>
            <select id="tri" @bind="_tri" @bind:after="Rechercher">
                @foreach (var t in Enum.GetValues<TriLivres>())
                {
                    <option value="@t">@Libelles.Tri(t)</option>
                }
            </select>
        </div>
        <div>
            <label for="dispo">Disponibilité</label>
            <select id="dispo" @bind="_disponibles" @bind:after="Rechercher">
                <option value="False">Tous les livres</option>
                <option value="True">Disponibles seulement</option>
            </select>
        </div>
        <button class="btn btn-principal" type="submit">Rechercher</button>
    </div>
</form>

<div class="puces" role="group" aria-label="Catégories">
    <button class="puce @(_categorieId == 0 ? "active" : "")" @onclick="() => Categorie(0)">Toutes</button>
    @foreach (var c in _categories)
    {
        <button class="puce @(_categorieId == c.Id ? "active" : "")" @onclick="() => Categorie(c.Id)">@c.Nom</button>
    }
</div>

<Message Erreur="@_erreur" />
@if (_resultat is null && _erreur is null)
{
    <p class="discret">Chargement des rayonnages…</p>
}
else if (_resultat is not null)
{
    <p class="discret">@_resultat.Total livre(s)</p>
    @if (_resultat.Total == 0)
    {
        <div class="carte">Aucun livre ne correspond. Essayez un autre mot, ou demandez conseil à <a href="assistant">Archimède</a>.</div>
    }
    <div class="etagere">
        @foreach (var l in _resultat.Elements)
        {
            <BookCard Livre="l" />
        }
    </div>
    <Pagination Page="_page" NbPages="_resultat.NbPages" PageChange="ChangerPage" />
}

@code {
    private string? _q;
    private int _categorieId;
    private TriLivres _tri = TriLivres.Titre;
    private bool _disponibles;
    private int _page = 1;
    private List<CategorieDto> _categories = [];
    private PageResultat<LivreDto>? _resultat;
    private string? _erreur;

    protected override async Task OnInitializedAsync()
    {
        _categories = (await Api.GetAsync<List<CategorieDto>>("api/categories")).Valeur?.Where(c => c.NbLivres > 0).ToList() ?? [];
        await Charger();
    }

    private async Task Rechercher()
    {
        _page = 1;
        await Charger();
    }

    private async Task Categorie(int id)
    {
        _categorieId = id;
        await Rechercher();
    }

    private async Task ChangerPage(int p)
    {
        _page = p;
        await Charger();
    }

    private async Task Charger()
    {
        var url = $"api/livres?page={_page}&taillePage=12&tri={_tri}&disponibles={_disponibles}"
                  + (string.IsNullOrWhiteSpace(_q) ? "" : $"&q={Uri.EscapeDataString(_q)}")
                  + (_categorieId > 0 ? $"&categorieId={_categorieId}" : "");
        var r = await Api.GetAsync<PageResultat<LivreDto>>(url);
        _resultat = r.Valeur;
        _erreur = r.Erreur;
    }
}
