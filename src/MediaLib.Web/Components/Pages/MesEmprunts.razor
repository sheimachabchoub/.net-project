@page "/mes-emprunts"
@attribute [Authorize(Roles = Roles.Membre)]
@inject ApiClient Api

<PageTitle>Mes emprunts — MediaLib</PageTitle>
<div class="entete-page">
    <h1>Mes emprunts</h1>
    <p>
        @(_emprunts?.Count ?? 0) emprunt(s) en cours sur @(_regles?.MaxEmprunts ?? 5) autorisés.
        Une prolongation de @(_regles?.ProlongationJours ?? 7) jours peut être demandée une fois ; un bibliothécaire la valide.
    </p>
</div>
<LegendeStatuts />
<Message Erreur="@_erreur" Succes="@_succes" />

@if (_emprunts is null)
{
    <p class="discret">Chargement…</p>
}
else if (_emprunts.Count == 0)
{
    <div class="carte">Vous n'avez aucun emprunt en cours. <a href="catalogue">Parcourir le catalogue</a></div>
}
else
{
    @foreach (var e in _emprunts)
    {
        var prolongeable = e.Statut != StatutEmprunt.EnRetard && e.NbProlongations < (_regles?.ProlongationsMax ?? 1);
        <article class="carte fiche-emprunt">
            <StatusBookmark Emprunt="e.Statut" />
            <h3><a href="livres/@e.LivreId" style="color:inherit">@e.LivreTitre</a></h3>
            <div class="infos-emprunt">
                <div><span class="libelle">Emprunté le</span>@e.DateEmprunt.ToString("dd/MM/yyyy")</div>
                <div><span class="libelle">À rendre le</span><strong>@e.DateRetourPrevue.ToString("dd/MM/yyyy")</strong></div>
                <div><span class="libelle">Statut</span><StatutBadge Emprunt="e.Statut" /> @if (e.JoursRetard > 0) { <span style="color:var(--terracotta-fonce);font-size:.85rem">@e.JoursRetard j de retard</span> }</div>
            </div>
            @if (prolongeable)
            {
                <button class="btn btn-contour btn-petit" style="margin-top:.7rem" @onclick="() => Prolonger(e)">Demander une prolongation</button>
            }
            else if (e.NbProlongations > 0)
            {
                <p class="discret" style="margin:.6rem 0 0">Déjà prolongé.</p>
            }
        </article>
    }
}

@code {
    private List<EmpruntDto>? _emprunts;
    private ReglesDto? _regles;
    private string? _erreur, _succes;

    protected override async Task OnInitializedAsync()
    {
        _regles = (await Api.GetAsync<ReglesDto>("api/regles")).Valeur;
        var r = await Api.GetAsync<List<EmpruntDto>>("api/emprunts/moi");
        _emprunts = r.Valeur ?? [];
        if (!r.Ok) _erreur = r.Erreur;
    }

    private async Task Prolonger(EmpruntDto e)
    {
        _erreur = _succes = null;
        var r = await Api.PostAsync<DecisionDto>($"api/emprunts/{e.Id}/prolongation");
        if (r.Ok) _succes = $"Demande de prolongation pour « {e.LivreTitre} » envoyée : elle attend la validation d'un bibliothécaire.";
        else _erreur = r.Erreur;
    }
}
