@page "/"
@inject ApiClient Api

<PageTitle>MediaLib — Bibliothèque Vivante</PageTitle>

<section class="hero">
    <div>
        <div class="surtitre">Bibliothèque Vivante</div>
        <h1>Une bibliothèque chaleureuse, ouverte à toute heure</h1>
        <p class="accroche">
            Parcourez le catalogue, empruntez vos livres en ligne et posez vos questions à Archimède,
            notre bibliothécaire IA, qui répond en citant le règlement.
        </p>
        <div class="actions">
            <a class="btn btn-principal btn-grand" href="catalogue">Explorer le catalogue</a>
            <a class="btn btn-contour btn-grand" href="assistant">Parler à l'agent IA</a>
        </div>
    </div>
    <div class="hero-illustration">
        <IllustrationBibliotheque />
    </div>
</section>

<section class="fonctions" aria-label="Fonctionnalités">
    <article class="fonction">
        <div class="icone"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></svg></div>
        <h3>Un catalogue clair</h3>
        <p>Recherche par titre, auteur ou ISBN, filtres par catégorie et disponibilité en temps réel.</p>
    </article>
    <article class="fonction">
        <div class="icone"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M7 3h10v18l-5-4-5 4z" /></svg></div>
        <h3>Des emprunts suivis</h3>
        <p>Jusqu'à @(_regles?.MaxEmprunts ?? 5) livres pendant @(_regles?.DureeJours ?? 21) jours, avec des marque-pages de couleur pour chaque statut.</p>
    </article>
    <article class="fonction">
        <div class="icone"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z" /></svg></div>
        <h3>Archimède, l'agent IA</h3>
        <p>Il cherche les livres, explique le règlement avec sa source, et passe la main à un bibliothécaire si besoin.</p>
    </article>
    <article class="fonction">
        <div class="icone"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 8v5l3 2" /><circle cx="12" cy="12" r="8" /></svg></div>
        <h3>Des rappels à temps</h3>
        <p>Un rappel avant l'échéance, par e-mail ou WhatsApp selon vos préférences.</p>
    </article>
</section>

<div class="section-titre">
    <h2>Nouveautés sur les rayonnages</h2>
    <a href="catalogue">Voir tout le catalogue →</a>
</div>
<Message Erreur="@_erreur" />
@if (_livres is null && _erreur is null)
{
    <p class="discret">Chargement…</p>
}
else if (_livres is not null)
{
    <div class="etagere">
        @foreach (var l in _livres)
        {
            <BookCard Livre="l" />
        }
    </div>
}

@code {
    private List<LivreDto>? _livres;
    private ReglesDto? _regles;
    private string? _erreur;

    protected override async Task OnInitializedAsync()
    {
        var livres = await Api.GetAsync<PageResultat<LivreDto>>("api/livres?tri=AnneeDesc&taillePage=5");
        _livres = livres.Valeur?.Elements.ToList();
        _erreur = livres.Erreur;
        _regles = (await Api.GetAsync<ReglesDto>("api/regles")).Valeur;
    }
}
